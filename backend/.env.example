# ================= 后端本地开发环境变量模板 =================
# 复制此文件为 .env 并填入实际值

DATABASE_URL=jdbc:postgresql://localhost:5432/ecommerce
DATABASE_USERNAME=admin
DATABASE_PASSWORD=your_password_here

# JWT 签名密钥：必填，不少于 32 字节；未配置或沿用源码公开默认值时后端启动即失败
JWT_SECRET=
# 开发环境演示口令兜底（admin/ant.design）：本地联调可设 true，生产必须保持 false
DEV_LOGIN_FALLBACK=false

REDIS_HOST=localhost
REDIS_PORT=6379

# Customer support contact info
SUPPORT_EMAIL=support@mystore.com
SUPPORT_WHATSAPP=
