<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.AddressMapper">

    <resultMap id="BaseResultMap" type="com.example.backend.entity.Address">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="is_default" property="isDefault"/>
        <result column="address_data" property="addressData"
                typeHandler="com.example.backend.config.JsonNodeTypeHandler"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM addresses WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM addresses WHERE user_id = #{userId} ORDER BY is_default DESC, created_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO addresses (user_id, is_default, address_data)
        VALUES (#{userId}, #{isDefault}, #{addressData, typeHandler=com.example.backend.config.JsonNodeTypeHandler})
    </insert>

    <update id="update">
        UPDATE addresses
        SET user_id = #{userId},
            is_default = #{isDefault},
            address_data = #{addressData, typeHandler=com.example.backend.config.JsonNodeTypeHandler}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM addresses WHERE id = #{id}
    </delete>
</mapper>
