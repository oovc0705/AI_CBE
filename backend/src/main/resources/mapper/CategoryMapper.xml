<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.CategoryMapper">

    <resultMap id="BaseResultMap" type="com.example.backend.entity.Category">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="name_i18n" property="nameI18n"
                typeHandler="com.example.backend.config.JsonNodeTypeHandler"/>
        <result column="slug" property="slug"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM categories WHERE id = #{id}
    </select>

    <select id="findBySlug" resultMap="BaseResultMap">
        SELECT * FROM categories WHERE slug = #{slug}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM categories ORDER BY created_at DESC LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM categories
    </select>

    <select id="findByParentId" resultMap="BaseResultMap">
        SELECT * FROM categories WHERE parent_id = #{parentId} ORDER BY created_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (parent_id, name_i18n, slug)
        VALUES (#{parentId}, #{nameI18n, typeHandler=com.example.backend.config.JsonNodeTypeHandler}, #{slug})
    </insert>

    <update id="update">
        UPDATE categories
        SET parent_id = #{parentId},
            name_i18n = #{nameI18n, typeHandler=com.example.backend.config.JsonNodeTypeHandler},
            slug = #{slug}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM categories WHERE id = #{id}
    </delete>
</mapper>
