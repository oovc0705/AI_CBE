<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.CurrencyMapper">

    <resultMap id="CurrencyResultMap" type="com.example.backend.entity.Currency">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="symbol" property="symbol"/>
        <result column="exchange_rate" property="exchangeRate"/>
        <result column="decimals" property="decimals"/>
        <result column="is_default" property="isDefault"/>
        <result column="enabled" property="enabled"/>
        <result column="rate_updated_at" property="rateUpdatedAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findById" resultMap="CurrencyResultMap">
        SELECT * FROM currencies WHERE id = #{id}
    </select>

    <select id="findByCode" resultMap="CurrencyResultMap">
        SELECT * FROM currencies WHERE code = #{code}
    </select>

    <select id="findAll" resultMap="CurrencyResultMap">
        SELECT * FROM currencies
        <where>
            <if test="enabled != null">AND enabled = #{enabled}</if>
        </where>
        ORDER BY is_default DESC, code
    </select>

    <insert id="insert">
        INSERT INTO currencies (id, code, name, symbol, exchange_rate, decimals, is_default, enabled, rate_updated_at, created_at, updated_at)
        VALUES (#{id}, #{code}, #{name}, #{symbol}, #{exchangeRate}, #{decimals}, #{isDefault}, #{enabled}, #{rateUpdatedAt}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE currencies
        SET code = #{code},
            name = #{name},
            symbol = #{symbol},
            exchange_rate = #{exchangeRate},
            decimals = #{decimals},
            is_default = #{isDefault},
            enabled = #{enabled},
            rate_updated_at = #{rateUpdatedAt},
            updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM currencies WHERE id = #{id}
    </delete>

    <update id="clearDefault">
        UPDATE currencies SET is_default = FALSE
    </update>

</mapper>
