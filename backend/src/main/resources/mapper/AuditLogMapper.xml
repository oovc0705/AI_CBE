<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.AuditLogMapper">

    <resultMap id="AuditLogResultMap" type="com.example.backend.entity.AuditLog">
        <id column="id" property="id"/>
        <result column="action" property="action"/>
        <result column="resource_type" property="resourceType"/>
        <result column="resource_id" property="resourceId"/>
        <result column="user_id" property="userId"/>
        <result column="user_name" property="userName"/>
        <result column="details" property="details" typeHandler="com.example.backend.config.JsonNodeTypeHandler"/>
        <result column="ip_address" property="ipAddress"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findAll" resultMap="AuditLogResultMap">
        SELECT * FROM audit_logs
        <where>
            <if test="action != null and action != ''">AND action = #{action}</if>
            <if test="resourceType != null and resourceType != ''">AND resource_type = #{resourceType}</if>
        </where>
        ORDER BY created_at DESC LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM audit_logs
        <where>
            <if test="action != null and action != ''">AND action = #{action}</if>
            <if test="resourceType != null and resourceType != ''">AND resource_type = #{resourceType}</if>
        </where>
    </select>

    <insert id="insert">
        INSERT INTO audit_logs (id, action, resource_type, resource_id, user_id, user_name, details, ip_address, created_at)
        VALUES (#{id}, #{action}, #{resourceType}, #{resourceId}, #{userId}, #{userName},
                #{details, typeHandler=com.example.backend.config.JsonNodeTypeHandler}, #{ipAddress}, #{createdAt})
    </insert>

</mapper>
