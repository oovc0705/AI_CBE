<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.OrderItemMapper">

    <resultMap id="BaseResultMap" type="com.example.backend.entity.OrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="sku_id" property="skuId"/>
        <result column="product_snapshot" property="productSnapshot"
                typeHandler="com.example.backend.config.JsonNodeTypeHandler"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM order_items WHERE id = #{id}
    </select>

    <select id="findByOrderId" resultMap="BaseResultMap">
        SELECT * FROM order_items WHERE order_id = #{orderId} ORDER BY created_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_items (order_id, sku_id, product_snapshot, price, quantity)
        VALUES (
            #{orderId},
            #{skuId},
            #{productSnapshot, typeHandler=com.example.backend.config.JsonNodeTypeHandler},
            #{price},
            #{quantity}
        )
    </insert>

    <insert id="insertBatch">
        INSERT INTO order_items (order_id, sku_id, product_snapshot, price, quantity)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.orderId}, #{item.skuId},
             #{item.productSnapshot, typeHandler=com.example.backend.config.JsonNodeTypeHandler},
             #{item.price}, #{item.quantity})
        </foreach>
    </insert>

    <delete id="deleteById">
        DELETE FROM order_items WHERE id = #{id}
    </delete>
</mapper>
