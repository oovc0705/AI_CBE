# ================= 后端生产环境配置基线 =================
# 用法：复制为生产环境的注入来源（K8s Secret / CI 变量 / 部署平台环境变量），
#       不要把这些值写进仓库。本地开发用 backend/.env。
#
# 与本地开发的关键差异：
#   1. DEV_LOGIN_FALLBACK 必须 false —— 否则 admin/ant.design 这个公开口令可直接登录后台
#   2. API_DOCS_ENABLED 必须 false —— swagger / api-docs / actuator info+prometheus 转为需鉴权
#   3. JWT_SECRET 必须是独立随机值（≥32 字节），且不能与任何环境共用
#   4. 数据库口令走密钥管理，不落文件

# ---------- 数据库 ----------
DATABASE_URL=jdbc:postgresql://<db-host>:5432/ecommerce
DATABASE_USERNAME=<db-user>
DATABASE_PASSWORD=<from-secret-manager>

# ---------- Redis（登录限流计数依赖它，多副本必须共享同一实例）----------
REDIS_HOST=<redis-host>
REDIS_PORT=6379

# ---------- JWT ----------
# 生成：openssl rand -hex 32
JWT_SECRET=<generate-a-unique-32-byte-secret>
JWT_EXPIRATION_MS=86400000

# ---------- 安全开关（生产固定值）----------
DEV_LOGIN_FALLBACK=false
API_DOCS_ENABLED=false

# ---------- CORS：只列正式域名，不要用通配或 localhost ----------
CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com

# ---------- 站点与客服 ----------
SITE_URL=https://shop.example.com
SUPPORT_EMAIL=support@example.com
SUPPORT_WHATSAPP=

# ---------- 登录限流阈值（可选，默认 60 秒 10 次）----------
# APP_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
# APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ================= 上线前自检 =================
# [ ] 用 admin/ant.design 登录 → 必须 401
# [ ] 未带 token 访问 /actuator/prometheus、/swagger-ui.html → 必须 401
# [ ] 未带 token 访问 /actuator/health → 200，但响应中不含 components 详情
# [ ] 不设 JWT_SECRET 启动 → 必须启动失败
# [ ] 普通顾客 token 访问 /api/admin/orders → 必须 403
# [ ] 顾客 A 的 token 读顾客 B 的订单 /api/orders/{id} → 必须 404
