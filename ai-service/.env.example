# ============================================================
# AI 服务环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=local                      # local / staging / prod
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- 模型供应商 API Key（按需填写） ----------
# 三选一即可，未填写的不会启用。本地测试离线可全部留空，用 Ollama。
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=                     # 智谱 GLM
DASHSCOPE_API_KEY=                 # 通义千问
OPENAI_API_KEY=                    # 可选，海外模型
STEPFUN_API_KEY=                   # StepFun AI

# ---------- 默认模型路由（决定每个任务用哪个模型） ----------
# 格式：<provider>/<model>，遵循 LiteLLM 命名
# 本地 Ollama 示例：ollama/qwen2.5:7b
# 云端示例：        deepseek/deepseek-chat、zhipu/glm-4-flash、dashscope/qwen-turbo
# StepFun 示例：    stepfun/stepfun-chat
# MODEL_CHAT=ollama/qwen2.5:7b              # 通用对话 - 本地Ollama
# MODEL_TOOL=ollama/qwen2.5:7b              # Function Calling 工具调用 - 本地Ollama
MODEL_CHAT=stepfun/stepfun-chat            # 通用对话 - StepFun AI
MODEL_TOOL=stepfun/stepfun-chat            # Function Calling 工具调用 - StepFun AI
# 向量化：本地 sentence-transformers（需装 torch，约 2.5GB）或云端（如 dashscope/text-embedding-v4，轻量）
MODEL_EMBEDDING=BAAI/bge-m3               # 本地默认；无 torch 时改 dashscope/text-embedding-v4

# ---------- Ollama（离线模型） ----------
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Java 后端（业务工具 API） ----------
JAVA_API_BASE_URL=http://localhost:8081
JAVA_API_TOKEN=                    # 服务间鉴权 token

# ---------- Redis（会话与缓存） ----------
REDIS_URL=redis://:redis123@localhost:6379/0
SESSION_TTL_SECONDS=86400          # 会话保留 24 小时

# ---------- Database（Copilot 历史持久化） ----------
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/ai_cbe

# ---------- 向量库 Chroma ----------
CHROMA_BASE_URL=http://localhost:8001
CHROMA_COLLECTION_COPILIT=copilot_kb
CHROMA_COLLECTION_CUSTOMER=customer_kb

# ---------- Copilot 安全策略 ----------
# 写操作（改价/退款/下架）必须经人工确认才执行
REQUIRE_HUMAN_CONFIRM_WRITE=true

# ---------- 工具层策略 ----------
# Java 后端不可用时是否回退到 MOCK 数据（local 默认 true，生产应设 false）
ENABLE_MOCK_FALLBACK=true

# ---------- 跨域（前端 storefront/admin） ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
